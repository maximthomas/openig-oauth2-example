{
  "heap": [],
  "handler": {
    "type": "Chain",
    "config": {
      "filters": [
        {
          "name": "UserInfoFilter",
          "type": "ScriptableFilter",
          "config": {
            "type": "application/x-groovy",
            "file": "userInfo.groovy",
            "args": {
              "userInfoUri": "https://login.yandex.ru/info?format=jwt"
            }
          }
        },
        {
          "name": "AuthorizationFilter",
          "type": "ScriptableFilter",
          "config": {
            "type": "application/x-groovy",
            "file": "policy.groovy",
            "args": {
              "allowedEmails": "${system.allowedEmails}"
            }
          }
        },
        {
          "type": "HeaderFilter",
          "config": {
            "messageType": "REQUEST",
            "add": {
              "Authorization": [
                "${session.userInfo}"
              ]
            }
          }
        }
      ],
      "handler": {
        "name": "EndpointHandler",
        "type": "DispatchHandler",
        "config": {
          "bindings": [
            {
              "handler": "ClientHandler",
              "capture": "all",
              "baseURI": "${system['endpoint.app']}"
            }
          ]
        }
      }
    }
  },
  "condition": "${matches(request.uri.path, '^/app')}",
  "baseURI": "http://openig.example.org:8080"
}