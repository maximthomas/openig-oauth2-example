{
  "heap": [],
  "handler": {
    "type": "Chain",
    "config": {
      "filters": [
        {
          "name": "ProtectedResourceFilter",
          "type": "OAuth2ResourceServerFilter",
          "config": {
            "accessTokenResolver": {
              "type": "ScriptableAccessTokenResolver",
              "config": {
                "type": "application/x-groovy",
                "file": "ResolveAccessToken.groovy",
                
                "args": {
                  "userInfoUri": "https://login.yandex.ru/info?format=jwt"
                }
              }
            },
            "requireHttps": false,
            "providerHandler": "ClientHandler",
            "scopes": [],
            "cacheExpiration": "2 minutes"
          }
        },
        {
          "name": "AuthorizationFilter",
          "type": "ScriptableFilter",
          "config": {
            "type": "application/x-groovy",
            "file": "policy.groovy",
            "args": {
              "allowedEmails": "${system.allowedEmails}"
            }
          }
        }
      ],
      "handler": {
        "name": "UserInfoHandler",
        "type":"StaticResponseHandler",
        "config": {
           "status": 200,
           "entity": "<h1>Authenticated with </h2>"
        }
      }
    }
  },
  "condition": "${matches(request.uri.path, '^/userinfo')}",
  "baseURI": "http://openig.example.org:8080"
}